{
  "name": "nuxt-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "clean": "rm -rf .output .wrangler",
    "dev": "wrangler dev",
    "dev:nuxt": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "deploy:prod": "ENVIRONMENT=production nuxt build && wrangler deploy",
    "deploy:preview": "wrangler dev",
    "db:migrate": "wrangler d1 migrations apply json-schema-playground --local",
    "db:migrate:prod": "wrangler d1 migrations apply json-schema-playground",
    "db:setup": "pnpm run db:migrate",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck",
    "check:fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/eslint": "1.7.1",
    "@nuxt/fonts": "0.11.4",
    "@nuxt/icon": "1.15.0",
    "@nuxt/image": "1.11.0",
    "@nuxt/scripts": "0.11.10",
    "@nuxt/test-utils": "3.19.2",
    "@nuxt/ui": "^3.3.0",
    "@pinia/nuxt": "0.11.2",
    "@unhead/vue": "^2.0.3",
    "@vueuse/core": "^13.8.0",
    "@xstate/vue": "^5.0.0",
    "ajv": "^8.17.1",
    "eslint": "^9.0.0",
    "monaco-editor": "^0.54.0",
    "nuxt": "^4.0.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1",
    "xstate": "^5.20.1"
  },
  "packageManager": "pnpm@9.15.3+sha512.1f79bc245a66eb0b07c5d4d83131240774642caaa86ef7d0434ab47c0d16f66b04e21e0c086eb61e62c77efc4d7f7ec071afad3796af64892fae66509173893a",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.10",
    "@cloudflare/workers-types": "^4.20251121.0",
    "@types/node": "^24.10.1",
    "@vitest/ui": "^3.2.4",
    "@vueuse/nuxt": "^13.8.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^27.2.0",
    "miniflare": "^4.20251118.1",
    "prettier": "3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.50.0"
  }
}
